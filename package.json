{
  "name": "youtube-autopilot",
  "version": "1.2.0",
  "description": "YouTube Workflow Automation Extension with Real Watch Tracking",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wxt",
    "build": "wxt build -b chrome",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "build:all": "wxt build -b chrome && wxt build -b firefox",
    "zip": "wxt zip -b chrome",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox",
    "zip:all": "wxt zip -b chrome && wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "submit:chrome": "wxt submit --chrome-zip .output/*-chrome.zip",
    "submit:firefox": "wxt submit --firefox-zip .output/*-firefox.zip --firefox-sources-zip .output/*-sources.zip",
    "submit:all": "npm run submit:chrome && npm run submit:firefox",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "idb": "^8.0.2",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.306",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "wxt": "^0.19.28"
  }
}
